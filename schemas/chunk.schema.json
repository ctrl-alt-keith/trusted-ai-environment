{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/trusted-ai-environment/chunk.schema.json",
  "title": "Evidence chunk",
  "type": "object",
  "required": [
    "chunk_id",
    "bundle_id",
    "source_id",
    "item_id",
    "ordinal",
    "chunk_type",
    "title",
    "text",
    "location",
    "time",
    "chunker",
    "token_estimate",
    "chunk_sha256",
    "sensitivity",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "chunk_id": {
      "type": "string",
      "pattern": "^chunk-[a-z0-9-]+-[0-9]+$"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src-[a-z0-9-]+$"
    },
    "item_id": {
      "type": "string",
      "pattern": "^item-[a-z0-9-]+$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "observed_at",
        "time_range"
      ],
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "time_range": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "chunker": {
      "type": "object",
      "required": [
        "name",
        "version",
        "config"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        }
      }
    },
    "token_estimate": {
      "type": "integer",
      "minimum": 0
    },
    "chunk_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sensitivity": {
      "type": "object",
      "required": [
        "level",
        "labels",
        "exportable",
        "retention",
        "handling"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exportable": {
          "type": "boolean"
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "handling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}

