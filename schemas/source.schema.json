{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/trusted-ai-environment/source.schema.json",
  "title": "Evidence source",
  "type": "object",
  "required": [
    "source_id",
    "source_type",
    "system",
    "title",
    "origin_ref",
    "retrieved_at",
    "retrieval_method",
    "retrieval_scope",
    "adapter",
    "trust_boundary",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^src-[a-z0-9-]+$"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "document",
        "event_stream",
        "issue_tracker",
        "change_log",
        "other"
      ]
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "origin_ref": {
      "type": "string",
      "minLength": 1
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "retrieval_method": {
      "type": "string",
      "minLength": 1
    },
    "retrieval_scope": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trust_boundary": {
      "type": "object",
      "required": [
        "level",
        "labels",
        "exportable",
        "retention",
        "handling"
      ],
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exportable": {
          "type": "boolean"
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "handling": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}

